@page "/new-case"
@using GridPilot.Data.Models
@using GridPilot.Data
@using GridPilot.Core
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<GridPilotContext> DbFactory

<div class="container mt-5">
    <div class="text-center mb-5">
        <h2 class="text-primary font-weight-bold">📁 Νέα Υπόθεση</h2>
        <p class="text-muted">Διαχείριση Μελετών - Τομέας Δυτικής Θεσσαλονίκης</p>
    </div>

    <div class="row">
        <!-- ΑΡΙΣΤΕΡΗ ΣΤΗΛΗ: ΦΟΡΜΑ ΕΙΣΑΓΩΓΗΣ -->
        <div class="col-lg-7">
            <!-- 1. ΣΤΟΙΧΕΙΑ ΚΑΤΑΝΑΛΩΤΗ -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Στοιχεία Καταναλωτή</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Αριθμός Πρωτοκόλλου</label>
                            <input type="text" class="form-control bg-light" @bind="protocolNumber" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Αριθμός Παροχής</label>
                            <input type="text" class="form-control" @bind="customer.SupplyNumber" maxlength="8"
                                placeholder="8-ψήφιος αριθμός" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Επωνυμία / Καταναλωτής</label>
                            <input type="text" class="form-control" @bind="customer.FullName"
                                placeholder="Όνομα ή Εταιρεία" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. ΤΟΠΟΘΕΣΙΑ -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Τοποθεσία Υπόθεσης</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Διεύθυνση (Οδός & Αριθμός)</label>
                            <input type="text" class="form-control" @bind="customer.StreetAddress" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Δήμος</label>
                            <input type="text" class="form-control" @bind="customer.Municipality" placeholder="π.χ. Δέλτα, Κορδελιού-Ευόσμου" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Συντεταγμένες</label>
                            <input type="text" class="form-control" @bind="customer.Location" placeholder="π.χ. 40.6401, 22.9444" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. ΕΠΙΛΟΓΗ ΠΑΡΟΧΗΣ -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Τεχνικά Χαρακτηριστικά Αίτησης</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Επίπεδο Τάσης</label>
                            <select class="form-select" @onchange="OnVoltageChanged">
                                <option value="LowVoltage">Χαμηλή Τάση (ΧΤ)</option>
                                <option value="MediumVoltage">Medium Voltage (ΜΤ)</option>
                            </select>
                        </div>

                        @if (supply.VoltageType == VoltageType.LowVoltage)
                        {
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Επιλογή Παροχής ΧΤ</label>
                                <select class="form-select" @onchange="OnLvCodeChanged">
                                    <option value="03">Νο 03 (8 kVA - Μονοφασική)</option>
                                    <option value="05">Νο 05 (12 kVA - Μονοφασική)</option>
                                    <option value="1" selected>Νο 1 (15 kVA - Τριφασική)</option>
                                    <option value="2">Νο 2 (25 kVA - Τριφασική)</option>
                                    <option value="3">Νο 3 (35 kVA - Τριφασική)</option>
                                    <option value="4">Νο 4 (55 kVA - Τριφασική)</option>
                                    <option value="5">Νο 5 (85 kVA - Τριφασική)</option>
                                    <option value="6">Νο 6 (135 kVA - Τριφασική)</option>
                                    <option value="7">Νο 7 (250 kVA - Τριφασική)</option>
                                </select>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Συμφωνημένη Ισχύς ΜΤ (kVA)</label>
                                <input type="number" class="form-control" @bind="supply.MvContractedPowerKva" step="50" min="50" />
                                <div class="form-text text-info">💡 Πρέπει να είναι πολλαπλάσιο του 50 kVA</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="text-center mb-4">
                <button class="btn btn-success btn-lg w-100 shadow-sm" @onclick="HandleSaveCase">
                    💾 Αποθήκευση Υπόθεσης & Εκκίνηση Μελέτης
                </button>
            </div>
        </div>

        <!-- ΔΕΞΙΑ ΣΤΗΛΗ: REAL-TIME ΠΡΟΕΠΙΣΚΟΠΗΣΗ ΠΑΡΑΜΕΤΡΩΝ ΔΕΔΔΗΕ -->
        <div class="col-lg-5">
            <div class="card shadow-sm position-sticky" style="top: 20px;">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">📊 Τεχνικές Παράμετροι ΔΕΔΔΗΕ</h5>
                    @if (supply.VoltageType == VoltageType.LowVoltage)
                    {
                        <span class="badge bg-info text-dark">Πίνακας V</span>
                    }
                </div>
                <div class="card-body bg-light">
                    @if (supply.VoltageType == VoltageType.LowVoltage && activeParam != null)
                    {
                        <div class="list-group list-group-flush shadow-sm rounded">
                            <div class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Ισχύς Παροχής:</span>
                                <span class="fw-bold text-primary">@activeParam.Kva kVA (@(activeParam.IsThreePhase ? "Τριφασική" : "Μονοφασική"))</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Γεν. Ασφάλεια Εγκ/στασης:</span>
                                <span class="fw-bold">@activeParam.InternalInstallationFuse A</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Ασφάλεια Μετρητή:</span>
                                <span class="fw-bold">@activeParam.MeterFuse A</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Μικροαυτόματος Μετρητή:</span>
                                <span class="fw-bold">@activeParam.MeterCircuitBreaker A</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Ελάχ. Αναχώρηση Δικτύου:</span>
                                <span class="fw-bold text-danger">@activeParam.MinNetworkDeparture A</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Τύπος Μετρητή:</span>
                                <span class="fw-bold">@activeParam.MeterRating A</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Συγκεντρικό Καλώδιο (Cu):</span>
                                <span class="fw-bold text-success">@activeParam.ConcentricCableCu mm²</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Καλώδιο X-LPE:</span>
                                <span class="fw-bold text-success">@activeParam.XlpeCable mm²</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Ελάχ. Διατομή Πίνακα-Μετρ.:</span>
                                <span class="fw-bold">@activeParam.MinLineCrossSection mm²</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Ελάχιστος Μ/Σ Υποσταθμού:</span>
                                <span class="fw-bold text-warning bg-dark px-2 rounded">@activeParam.MinTransformerKva kVA</span>
                            </div>
                        </div>
                    }
                    else if (supply.VoltageType == VoltageType.MediumVoltage)
                    {
                        <div class="alert alert-warning mb-0 shadow-sm">
                            💡 Επιλέχθηκε Μέση Τάση (ΜΤ). Οι τεχνικές παράμετροι καθορίζονται ανάλογα με τη Συμφωνημένη Ισχύ.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private CaseService caseService { get; set; } = default!;
    private Customer customer = new Customer();
    private CustomerSupply supply = new CustomerSupply { VoltageType = VoltageType.LowVoltage };
    private LvSupplyParameter? activeParam;
    private string protocolNumber = "";
    private string currentLvCode = "1";

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        int totalCases = await context.Customers.CountAsync() + 1;
        protocolNumber = $"ΔΘ-{DateTime.Now.Year}-{totalCases:D3}";
        await LoadLvParameters();
    }

    private async Task OnVoltageChanged(ChangeEventArgs e)
    {
        string? stringValue = e.Value?.ToString();
        
        // Διορθώθηκε: Δηλώνουμε ρητά τον τύπο <VoltageType> για να αποφευχθεί το σφάλμα CS0411
        if (Enum.TryParse<VoltageType>(stringValue, out var result))
        {
            supply.VoltageType = result;
            if (result == VoltageType.LowVoltage)
            {
                await LoadLvParameters();
            }
            else
            {
                supply.MvContractedPowerKva = 50;
                activeParam = null;
            }
        }
    }

    private async Task OnLvCodeChanged(ChangeEventArgs e)
    {
        currentLvCode = e.Value?.ToString() ?? "1";
        await LoadLvParameters();
    }

    private async Task LoadLvParameters()
    {
        // Διορθώθηκε: Βγήκε από τα σχόλια και καλείται το caseService για real-time ενημέρωση του UI
        activeParam = await caseService.GetLvParameterByCodeAsync(currentLvCode);
    }

    private async Task HandleSaveCase()
    {
        if (supply.VoltageType == VoltageType.LowVoltage && activeParam != null)
        {
            supply.LvSupplyParameterId = activeParam.Id;
            supply.MvContractedPowerKva = null;
        }

        await caseService.SaveCaseAsync(customer, supply);
        customer = new Customer();
        supply = new CustomerSupply { VoltageType = VoltageType.LowVoltage };
        
        using var context = await DbFactory.CreateDbContextAsync();
        int totalCases = await context.Customers.CountAsync() + 1;
        protocolNumber = $"ΔΘ-{DateTime.Now.Year}-{totalCases:D3}";
        await LoadLvParameters();
    }
}